<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="syc_pm_client.Views.AddUserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:syc_pm_client.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:converters="using:syc_pm_client.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:viewmodels="using:syc_pm_client.Viewmodels" 
    d:DataContext="{d:DesignInstance Type=viewmodels:AddUserViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" Padding="32" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock 
                    FontSize="28" 
                    FontWeight="SemiBold" 
                    Text="Register" 
                    HorizontalAlignment="Center" Margin="0,0,0,8" />

                <TextBox 
                    Header="Username" 
                    PlaceholderText="Enter Username" 
                    Text="{Binding Username, Mode=TwoWay}" 
                    KeyDown="Register_KeyDown" Margin="0,0,0,12" />

                <PasswordBox PasswordRevealMode="Peek" PlaceholderText="Enter Password" PasswordChar="●" x:Name="PasswordBox" KeyDown="Register_KeyDown" >
                    <PasswordBox.Header>
                        <Grid>
                            <TextBlock Text="Password  (min. 8 chars)"
                                        VerticalAlignment="Bottom"/>
                            <Button
                                Command="{Binding GeneratePasswordCommand}"
                                Padding="5,1"
                                HorizontalAlignment="Right">
                                <SymbolIcon Symbol="Shuffle" />
                            </Button>
                        </Grid>
                    </PasswordBox.Header>
                </PasswordBox>
                <PasswordBox PasswordRevealMode="Peek" PlaceholderText="Repeat Password" PasswordChar="●" x:Name="RepeatPasswordBox" KeyDown="Register_KeyDown" />
                <CheckBox 
                    x:Name="RevealModeCheckBox"
                    Content="Show password" 
                    IsChecked="False"
                    Checked="RevealModeCheckbox_Changed" 
                    Unchecked="RevealModeCheckbox_Changed"/>
                <!--
                    Peek Mode funktioniert nur beim ersten Eintippen des Passworts, aber anscheinend ist das von Microsoft so gewollt:
                        "The password reveal button is shown only when the PasswordBox receives focus for the first time and a character is entered. 
                         If the PasswordBox loses focus and then regains focus, the reveal button is not shown again unless the password is cleared 
                         and character entry starts over."
                    Quelle: https://learn.microsoft.com/en-us/windows/apps/develop/ui/controls/password-box#peek-mode
                -->
                <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{Binding ErrorMessage}" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" TextWrapping="Wrap" />
                <StackPanel Spacing="0">
                    <Button Content="Submit" Command="{Binding SubmitCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>