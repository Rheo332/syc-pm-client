<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="syc_pm_client.Views.MakeRequestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:syc_pm_client.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:syc_pm_client.Viewmodels"
    d:DataContext="{d:DesignInstance Type=viewmodels:MakeRequestViewModel}"
    mc:Ignorable="d">

	<Grid>
		<Border
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Width="360"
			MaxHeight="700"
			Padding="32"
			CornerRadius="8"
			Background="{ThemeResource LayerFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1">

			<Grid RowDefinitions="Auto,*,Auto">
				<TextBlock
					Text="Submit a Request"
					FontSize="20"
					FontWeight="Bold" />

				<ScrollViewer
					Grid.Row="1"
					VerticalScrollBarVisibility="Auto"
					HorizontalScrollBarVisibility="Disabled"
					Padding="0,0,12,0"
					Margin="0,16,0,16">

					<StackPanel Spacing="16">

						<ComboBox
							Header="Request Type"
							SelectedItem="{Binding RequestType, Mode=TwoWay}"
							HorizontalAlignment="Stretch">

							<x:String>Add</x:String>
							<x:String>Edit</x:String>
							<x:String>Remove</x:String>

						</ComboBox>

						<TextBox
							Header="Target Entry ID"
							PlaceholderText="Required for Edit/Remove"
							Text="{Binding TargetEntryId, Mode=TwoWay}"
							Visibility="{Binding IsTargetIdVisible, Mode=OneWay}" />

						<TextBox
							Header="Title"
							PlaceholderText="Enter Title"
							Text="{Binding Title, Mode=TwoWay}"
							Visibility="{Binding IsFormVisible, Mode=OneWay}" />

						<TextBox
							Header="Url"
							PlaceholderText="Enter URL"
							Text="{Binding Url, Mode=TwoWay}"
							Visibility="{Binding IsFormVisible, Mode=OneWay}" />

						<TextBox
							Header="Username"
							PlaceholderText="Enter Username"
							Text="{Binding Username, Mode=TwoWay}"
							Visibility="{Binding IsFormVisible, Mode=OneWay}" />

						<TextBox
							Header="Password"
							PlaceholderText="Enter Password"
							Text="{Binding Password, Mode=TwoWay}"
							Visibility="{Binding IsFormVisible, Mode=OneWay}" />

						<TextBox
							Header="Description (optional)"
							PlaceholderText="Enter Description"
							Text="{Binding Description, Mode=TwoWay}"
							Visibility="{Binding IsFormVisible, Mode=OneWay}" />

						<TextBlock
							Foreground="{ThemeResource SystemFillColorCriticalBrush}"
							Text="{Binding ErrorMessage}"
							Visibility="{Binding HasError, Mode=OneWay}"
							TextWrapping="Wrap" />

					</StackPanel>

				</ScrollViewer>

				<!-- Buttons -->
				<StackPanel
					Grid.Row="2"
					Spacing="8">

					<Button
						Content="Submit Request"
						Command="{Binding SubmitCommand}"
						Style="{StaticResource AccentButtonStyle}"
						HorizontalAlignment="Stretch" />

					<Button
						Content="Cancel"
						Command="{Binding CancelCommand}"
						Style="{StaticResource AccentButtonStyle}"
						HorizontalAlignment="Stretch" />

				</StackPanel>

			</Grid>

		</Border>
	</Grid>
</Page>
