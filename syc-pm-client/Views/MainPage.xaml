<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="syc_pm_client.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:syc_pm_client.Views"
    xmlns:converters="using:syc_pm_client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="0,31,0,0" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="Column0" Width="1*" />
            <ColumnDefinition x:Name="Column1" Width="0" />
        </Grid.ColumnDefinitions>

        <Border 
            BorderBrush="Transparent"
            BorderThickness="1,1,1,1"
            Padding="10"
            Grid.Column="0">

            <Grid 
                x:Name="Accounts"
                Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="AccountsBar"
                            Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="20"
                            Padding="20"
                            Margin="0">

                    <TextBox x:Name="SearchBox"
                             Grid.Row="0"
                             HorizontalAlignment="Center"
                             PlaceholderText="Search..."
                             Width="200"
                             Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                             BorderThickness="2"
                             CornerRadius="6">
                    </TextBox>

                    <Button x:Name="AddItemButton"
                            Width="50"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding AddEntryCommand}">
                        <SymbolIcon Symbol="Add" />
                    </Button>

                    <Button x:Name="AddUserButton"
                            Width="50"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding AddUserCommand}">
                        <SymbolIcon Symbol="Contact" />
                    </Button>

                    <Button x:Name="RequestsButton"
                            Width="50"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding OpenRequestsCommand}">
                        <SymbolIcon Symbol="List" />
                    </Button>

                    <Button x:Name="MakeRequestButton"
                            Width="50"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding OpenMakeRequestCommand}">
                        <SymbolIcon Symbol="Message" />
                    </Button>
                </StackPanel>

                <ListView x:Name="AccountsList"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        Margin="10"
                        ItemsSource="{Binding Accounts}"
                        SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                        IsItemClickEnabled="True"
                        ItemClick="AccountsList_ItemClick">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="5" />
                            <Setter Property="Padding" Value="4,2,4,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border 
                                Padding="10"
                                Margin="0"
                                Height="100"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" />
                                    <TextBlock Text="{Binding URL}" FontSize="14" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

        </Border>

        <Border BorderBrush="Transparent"
            BorderThickness="1,1,1,1"
            Padding="10"
            Margin="0"
            Grid.Column="1"
            Visibility="{Binding SelectedAccount, Converter={StaticResource NullToVisibilityConverter}}">

            <Grid x:Name="Accountdetails">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <StackPanel
                    Orientation="Horizontal"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    Spacing="20">

                    <TextBlock 
                        Text="Account Details"
                        Grid.Row="0"
                        FontSize="20"
                        Margin="20"/>

                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="10"
                    Padding="20">


                    <Grid RowSpacing="12" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Title:"
                           FontWeight="SemiBold"
                           FontSize="16"/>
                        <TextBlock Grid.Column="1"
                           Text="{Binding SelectedAccount.Name}"
                           FontSize="16"/>

                        <TextBlock Grid.Row="1"
                           Text="Username:"
                           FontWeight="SemiBold"
                           FontSize="16"/>
                        <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding SelectedAccount.Username}"
                           FontSize="16"/>

                        <TextBlock Grid.Row="2"
                           Text="Password:"
                           FontWeight="SemiBold"
                           FontSize="16"/>
                        <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding SelectedAccount.Password}"
                           FontSize="16"/>

                        <TextBlock Grid.Row="3"
                           Text="URL:"
                           FontWeight="SemiBold"
                           FontSize="16"/>
                        <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="{Binding SelectedAccount.URL}"
                           FontSize="16"/>

                        <TextBlock Grid.Row="4"
                           Text="Description:"
                           FontWeight="SemiBold"
                           FontSize="16"/>
                        <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Text="{Binding SelectedAccount.Notes}"
                           FontSize="16"
                           TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>