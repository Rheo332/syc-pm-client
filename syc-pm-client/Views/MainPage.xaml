<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="syc_pm_client.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:syc_pm_client.Views"
    xmlns:converters="using:syc_pm_client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullToVisibilityConverter
            x:Key="NullToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            Grid.Row="0"
            Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3" Orientation="Horizontal">
                <TextBlock
                    Text="Accounts"
                    FontSize="28"
                    FontWeight="SemiBold" />
                <Button
                    Click="Refresh_Click"
                    ToolTipService.ToolTip="Refresh"
                    Margin="12,4,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <!--
                <Button
                    Command="{Binding AddEntryCommand}"
                    ToolTipService.ToolTip="Add new entry">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock Text="Add" />
                    </StackPanel>
                </Button>
                -->
                <Button
                    Command="{Binding OpenGiveAccessCommand}"
                    IsEnabled="{Binding IsAdmin}"
                    ToolTipService.ToolTip="Manage access">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <SymbolIcon Symbol="ContactPresence" />
                        <TextBlock Text="Manage Access" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding OpenRequestsCommand}"
                    IsEnabled="{Binding IsAdmin}"
                    ToolTipService.ToolTip="Manage requests">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <SymbolIcon Symbol="List" />
                        <TextBlock Text="Requests" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding OpenMakeRequestCommand}"
                    ToolTipService.ToolTip="Make request">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <SymbolIcon Symbol="Message" />
                        <TextBlock Text="Make Request" />
                    </StackPanel>
                </Button>
                
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="25" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12"
                Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Row="0"
                        PlaceholderText="Search accounts..."
                        Margin="0,0,0,12" />
                    <ListView
                        x:Name="AccountsList"
                        Grid.Row="1"
                        ItemsSource="{Binding Accounts}"
                        SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                        IsItemClickEnabled="True"
                        ItemClick="AccountsList_ItemClick"
                        SelectionMode="Single"
                        BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter
                                    Property="HorizontalContentAlignment"
                                    Value="Stretch" />

                                <Setter
                                    Property="VerticalContentAlignment"
                                    Value="Stretch" />

                                <Setter
                                    Property="Padding"
                                    Value="12" />

                                <Setter
                                    Property="Margin"
                                    Value="0,2" />

                                <Setter
                                    Property="CornerRadius"
                                    Value="8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition  Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        Spacing="3">

                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Text="{Binding URL}"
                                            FontSize="13"
                                            Opacity="0.65"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Text="{Binding Username}"
                                            FontSize="12"
                                            Opacity="0.5"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <FontIcon
                                        Grid.Column="1"
                                        Glyph="&#xE76C;"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        Opacity="0.45" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" />

            <Border
                Grid.Column="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12"
                Padding="32"
                Visibility="{Binding SelectedAccount, Converter={StaticResource NullToVisibilityConverter}}">

                <ScrollViewer>

                    <StackPanel Spacing="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <Grid Padding="0,0,15,0">
                                    <TextBlock
                                        Text="{Binding SelectedAccount.Name}"
                                        FontSize="26"
                                        FontWeight="SemiBold" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        Grid.Column="1"
                                        ToolTipService.ToolTip="Edit">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Edit" Command="{Binding EditEntryCommand}"/>
                                                <MenuFlyoutItem Text="Delete" Command="{Binding DeleteEntryCommand}"/>
                                            </MenuFlyout>
                                        </Button.Flyout>

                                        <SymbolIcon Symbol="More" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                        </Grid>

                        <StackPanel Spacing="18">

                            <StackPanel
                                Spacing="5">

                                <TextBlock
                                    Text="Username"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Opacity="0.65" />

                                <Border
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="6"
                                    Padding="12">

                                    <TextBlock
                                        Text="{Binding SelectedAccount.Username}"
                                        FontSize="15"
                                        TextTrimming="CharacterEllipsis" />

                                </Border>

                            </StackPanel>

                            <StackPanel Spacing="5">

                                <TextBlock
                                    Text="Password"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Opacity="0.65" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <PasswordBox
                                        x:Name="PasswordBoxControl"
                                        Grid.Column="0"
                                        Password="{Binding SelectedAccount.Password, Mode=OneWay}"
                                        FontSize="15"
                                        FontFamily="Consolas"
                                        IsEnabled="False" />

                                    <Button
                                        Grid.Column="1"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Stretch"
                                        Command="{Binding CopyPasswordCommand}">
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock
                                    Text="Website"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Opacity="0.65" />

                                <Border
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="6"
                                    Padding="12">

                                    <TextBlock
                                        Text="{Binding SelectedAccount.URL}"
                                        FontSize="15"
                                        TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock
                                    Text="Notes"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Opacity="0.65" />
                                <Border
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="6"
                                    Padding="12">
                                    <TextBlock
                                        Text="{Binding SelectedAccount.Notes}"
                                        FontSize="15"
                                        TextWrapping="Wrap"
                                        LineHeight="22" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
