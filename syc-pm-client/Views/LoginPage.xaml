<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="syc_pm_client.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:syc_pm_client.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:converters="using:syc_pm_client.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="using:syc_pm_client.Viewmodels" d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" Padding="32" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="16">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Welcome!" HorizontalAlignment="Center" Margin="0,0,0,8" />

                <TextBox Header="Username" PlaceholderText="Enter your username" Text="{Binding Username, Mode=TwoWay}" KeyDown="Login_KeyDown" />
                <PasswordBox Header="Password" PlaceholderText="Enter your password" PasswordChar="●" x:Name="PasswordBox" KeyDown="Login_KeyDown" />

                <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{Binding ErrorMessage}" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" TextWrapping="Wrap" />

                <Button Content="Login" Command="{Binding LoginCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0" />
                <Button Content="Register" Command="{Binding RegisterCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
